# Optional contact form endpoint.
#
# When set, the contact form POSTs { name, email, subject, message } as JSON to this URL.
# When unset (default), the form opens the visitor's email client via a mailto: link
# instead of pretending a message was sent.
#
# Example (Formspree):
# VITE_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
VITE_CONTACT_ENDPOINT=
